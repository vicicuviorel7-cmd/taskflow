* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #0f172a;
    color: #f8fafc;
    line-height: 1.6;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 7%;
    background: #111c30;
    border-bottom: 1px solid #334155;
}

.logo {
    font-size: 28px;
    font-weight: bold;
}

.logo span {
    color: #38bdf8;
}

.version {
    color: #94a3b8;
}

main {
    max-width: 1200px;
    margin: auto;
    padding: 30px;
}

.hero {
    text-align: center;
    padding: 60px 15px;
}

.badge {
    background: #164e63;
    color: #67e8f9;
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 12px;
    letter-spacing: 2px;
}

h1 {
    font-size: clamp(30px, 5vw, 54px);
    line-height: 1.2;
    margin: 25px 0;
}

.hero p {
    color: #94a3b8;
    margin-bottom: 30px;
}

.button {
    display: inline-block;
    padding: 13px 25px;
    background: #38bdf8;
    color: #0f172a;
    text-decoration: none;
    font-weight: bold;
    border-radius: 9px;
}

.button:hover {
    background: #7dd3fc;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    background: #1e293b;
    padding: 25px;
    border: 1px solid #334155;
    border-radius: 15px;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
    border-color: #38bdf8;
}

.number {
    color: #38bdf8;
    font-size: 26px;
    font-weight: bold;
}

.card h2 {
    margin: 10px 0;
    font-size: 21px;
}

.card p {
    color: #94a3b8;
    font-size: 14px;
}

.status {
    margin-top: 30px;
    padding: 15px;
    text-align: center;
    background: #052e26;
    color: #6ee7b7;
    border: 1px solid #166534;
    border-radius: 10px;
}

footer {
    padding: 25px;
    text-align: center;
    color: #94a3b8;
    font-size: 14px;
}

@media (max-width: 800px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 500px) {
    .cards {
        grid-template-columns: 1fr;
    }
}